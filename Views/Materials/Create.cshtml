@model OnlineLearningApp.MaterialUploadViewModel
@{
    ViewData["Title"] = "Add Learning Material";
}

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="mb-4">
                <div class="eyebrow">Administration</div>
                <h1 class="section-title h2 mb-1">Add learning material</h1>
                <p class="text-muted-custom mb-0">Attach a trusted online resource or upload a course file.</p>
            </div>

            <div class="surface p-4 p-lg-5">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="ModuleId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold"></label>
                        <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Python official tutorial" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Briefly explain why this resource is useful."></textarea>
                    </div>

                    <div class="p-3 rounded-3 border mb-3">
                        <label asp-for="ResourceUrl" class="form-label fw-semibold"></label>
                        <input asp-for="ResourceUrl" class="form-control" placeholder="https://..." />
                        <div class="small text-muted-custom mt-2">Use official documentation, open educational resources, or another resource you are authorized to share.</div>
                        <span asp-validation-for="ResourceUrl" class="text-danger small"></span>
                    </div>

                    <div class="text-center text-muted-custom my-3">OR</div>

                    <div class="p-3 rounded-3 border mb-4">
                        <label asp-for="File" class="form-label fw-semibold"></label>
                        <input asp-for="File" type="file" class="form-control" />
                        <div class="small text-muted-custom mt-2">Maximum 25 MB. Allowed: PDF, Word, PowerPoint, Excel, CSV, TXT, ZIP, MP4, WebM, PNG and JPEG.</div>
                        <span asp-validation-for="File" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between gap-2">
                        <a asp-controller="Module" asp-action="Index" class="btn btn-soft">Back to modules</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-cloud-arrow-up me-1"></i> Add material</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

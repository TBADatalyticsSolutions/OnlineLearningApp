@model IEnumerable<OnlineLearningApp.Models.CourseMasteryViewModel>
@{ ViewData["Title"] = "Course Mastery"; }
<div class="container py-5"><div class="eyebrow">Learner analytics</div><h1 class="h2 fw-bold">Course mastery</h1><p class="text-muted mb-4">Track learning completion, assessment mastery, payment and capstone readiness.</p><div class="row g-4">@foreach(var item in Model){<div class="col-lg-6"><div class="surface p-4 h-100"><div class="d-flex justify-content-between"><h2 class="h5">@item.CourseName</h2><span class="badge text-bg-light">@item.OverallMastery.ToString("N2")%</span></div><div class="progress my-3" style="height:10px"><div class="progress-bar" style="width:@item.OverallMastery%"></div></div><div class="row small g-2"><div class="col-6">Modules: <strong>@item.CompletedModules/@item.TotalModules</strong></div><div class="col-6">Assessments: <strong>@item.PassedAssessments/@item.TotalAssessments</strong></div><div class="col-6">Learning: <strong>@item.CompletionPercentage.ToString("N2")%</strong></div><div class="col-6">Assessment: <strong>@item.AssessmentMastery.ToString("N2")%</strong></div><div class="col-6">Payment: <strong>@(item.Paid ? "Confirmed" : "Pending")</strong></div><div class="col-6">Capstone: <strong>@(item.CapstoneApproved ? "Approved" : "Pending")</strong></div></div></div></div>}</div></div>

@model OnlineLearningApp.Models.InstructorPerformanceViewModel
@{
    ViewData["Title"] = "Instructor performance";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="mb-4"><div class="eyebrow">Teaching intelligence</div><h1 class="section-title h2 mb-1">Instructor performance monitoring</h1><p class="text-muted-custom mb-0">Monitor learner engagement, assessment outcomes and course completion.</p></div>
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="dashboard-card p-4"><div class="small text-muted-custom">Courses</div><strong class="display-6">@Model.CourseCount</strong></div></div>
        <div class="col-md-3"><div class="dashboard-card p-4"><div class="small text-muted-custom">Learners</div><strong class="display-6">@Model.ActiveLearners</strong></div></div>
        <div class="col-md-3"><div class="dashboard-card p-4"><div class="small text-muted-custom">Avg. assessment</div><strong class="display-6">@Model.AverageAssessmentScore.ToString("0.00")%</strong></div></div>
        <div class="col-md-3"><div class="dashboard-card p-4"><div class="small text-muted-custom">Pass rate</div><strong class="display-6 text-success">@Model.PassRate.ToString("0.00")%</strong></div></div>
    </div>
    <div class="surface p-0 overflow-hidden">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th class="px-4 py-3">Course</th><th>Learners</th><th>Completed</th><th>Attempts</th><th>Avg. score</th><th>Pass rate</th><th>Completion</th></tr></thead>
          <tbody>
          @foreach(var row in Model.Courses)
          {
            <tr><td class="px-4 fw-semibold">@row.CourseName</td><td>@row.Learners</td><td>@row.CompletedLearners</td><td>@row.QuizAttempts</td><td>@row.AverageScore.ToString("0.00")%</td><td>@row.PassRate.ToString("0.00")%</td><td>@row.CompletionRate.ToString("0.00")%</td></tr>
          }
          </tbody>
        </table>
      </div>
    </div>
</div>

@model OnlineLearningApp.Models.Course
@using OnlineLearningApp.Models
@{ ViewData["Title"]=$"Learning · {Model.CourseName}"; var completedModuleIds=ViewBag.CompletedModuleIds as List<int>??new List<int>(); var completedModuleCount=ViewBag.CompletedModuleCount is int completed?completed:0; var progressPercentage=ViewBag.ProgressPercentage is int progress?progress:0; var isCourseCompleted=ViewBag.IsCourseCompleted is bool flag&&flag; var hasPaid=ViewBag.HasPaid is bool paid&&paid; var capstone=ViewBag.Capstone as CapstoneSubmission; }
<div class="container-fluid px-3 px-lg-4 py-4"><div class="row g-4"><div class="col-xl-8"><a asp-action="Details" asp-route-id="@Model.Id" class="small text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Course overview</a><div class="mt-3 mb-4"><div class="eyebrow">@Model.Category · Learning workspace</div><h1 class="h2 fw-bold mb-2">@Model.CourseName</h1><p class="text-muted-custom mb-0">Learn, practice, complete the applied capstone, and earn your certificate.</p></div>
@if(!Model.Modules.Any()){<div class="empty-state">No modules have been published yet.</div>}else{<div class="d-flex flex-column gap-3">@foreach(var module in Model.Modules.OrderBy(m=>m.ModuleId)){<div class="module-card"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#module-@module.ModuleId"><span class="badge rounded-pill bg-primary-subtle text-primary me-3">@module.ModuleId.ToString("00")</span><span>@module.ModuleName</span></button><div id="module-@module.ModuleId" class="collapse"><div class="lesson-panel"><div class="eyebrow mb-2">Lesson content</div><div class="lesson-content mb-4">@module.Content</div>@if(module.Materials.Any()){<div class="mb-4"><div class="eyebrow mb-2">Learning materials</div><div class="d-flex flex-column gap-2">@foreach(var material in module.Materials.OrderBy(m=>m.CreatedAt)){<a asp-controller="Materials" asp-action="Open" asp-route-id="@material.Id" class="surface p-3 d-flex align-items-center gap-3 text-decoration-none text-reset" target="_blank"><span class="brand-mark flex-shrink-0"><i class="bi @(material.MaterialType=="File"?"bi-file-earmark-arrow-down":"bi-box-arrow-up-right")"></i></span><span class="flex-grow-1"><strong class="d-block">@material.Title</strong>@if(!string.IsNullOrWhiteSpace(material.Description)){<span class="small text-muted-custom">@material.Description</span>}</span><i class="bi bi-chevron-right text-muted"></i></a>}}</div></div>}
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 p-3 rounded-3 border bg-light-subtle"><div><strong>@(completedModuleIds.Contains(module.ModuleId)?"Module completed":"Ready to complete?")</strong><div class="small text-muted-custom mt-1">@(completedModuleIds.Contains(module.ModuleId)?"Your progress has been saved.":"Mark this module complete after reviewing the lesson content.")</div></div>@if(completedModuleIds.Contains(module.ModuleId)){<span class="badge rounded-pill bg-success-subtle text-success px-3 py-2"><i class="bi bi-check-circle me-1"></i> Completed</span>}else{<form asp-action="CompleteModule" method="post" class="m-0">@Html.AntiForgeryToken()<input type="hidden" name="courseId" value="@Model.Id"/><input type="hidden" name="moduleId" value="@module.ModuleId"/><button type="submit" class="btn btn-outline-primary"><i class="bi bi-check2-circle me-1"></i> Mark complete</button></form>}</div>
@foreach(var quiz in module.Quizzes.OrderBy(q=>q.QuizId)){<div class="surface p-3 d-flex flex-wrap align-items-center justify-content-between gap-3"><div><strong>@quiz.QuizName</strong><div class="small text-muted-custom mt-1">@quiz.Questions.Count question(s) · @(hasPaid?"Assessment unlocked":"Payment required before graded assessment")</div></div>@if(hasPaid){<a asp-controller="Quiz" asp-action="Take" asp-route-id="@quiz.QuizId" class="btn btn-primary"><i class="bi bi-play-circle me-1"></i> Start checkpoint</a>}else{<a asp-controller="Orders" asp-action="ShoppingCart" class="btn btn-outline-primary"><i class="bi bi-lock me-1"></i> Complete payment</a>}</div>}
</div></div></div>}}</div>}
</div><div class="col-xl-4"><aside class="learning-sidebar">@if(isCourseCompleted){<div class="dashboard-card p-4 mb-3"><div class="eyebrow">Achievement unlocked</div><h2 class="h5 fw-bold mt-2">Certificate of completion</h2><p class="small text-muted-custom">All course requirements have been satisfied.</p><a asp-controller="Certificate" asp-action="View" asp-route-courseId="@Model.Id" class="btn btn-primary"><i class="bi bi-award me-1"></i> View certificate</a></div>}else{<div class="dashboard-card p-4 mb-3"><div class="eyebrow">Completion requirements</div><div class="d-flex justify-content-between py-2"><span>Payment</span><span class="badge rounded-pill @(hasPaid?"text-bg-success":"text-bg-warning")">@(hasPaid?"Paid":"Pending")</span></div><div class="d-flex justify-content-between py-2"><span>Modules</span><span>@completedModuleCount/@Model.Modules.Count</span></div><div class="d-flex justify-content-between py-2"><span>Capstone</span><span class="badge rounded-pill @(capstone?.Status==CapstoneSubmissionStatus.Approved?"text-bg-success":"text-bg-secondary")">@(capstone?.Status.ToString()??"Not submitted")</span></div>@if(Model.RequireCapstone){<a asp-controller="Capstone" asp-action="Submit" asp-route-courseId="@Model.Id" class="btn btn-outline-primary w-100 mt-3"><i class="bi bi-kanban me-1"></i> Open capstone</a>}</div>}
<div class="dashboard-card p-4 mb-3"><div class="d-flex justify-content-between align-items-center mb-2"><strong>Course progress</strong><span class="small fw-bold text-primary">@progressPercentage%</span></div><div class="progress mb-3"><div class="progress-bar" style="width:@progressPercentage%"></div></div><div class="d-flex justify-content-between small text-muted-custom"><span>@completedModuleCount of @Model.Modules.Count modules</span><span>@(isCourseCompleted?"Completed":"Keep going")</span></div></div><div class="dashboard-card p-4"><div class="eyebrow">Course at a glance</div><div class="d-flex justify-content-between py-3 border-bottom"><span class="text-muted-custom">Modules</span><strong>@Model.Modules.Count</strong></div><div class="d-flex justify-content-between py-3 border-bottom"><span class="text-muted-custom">Checkpoints</span><strong>@Model.Modules.Sum(m=>m.Quizzes.Count)</strong></div><div class="d-flex justify-content-between py-3"><span class="text-muted-custom">Instructor</span><strong>@(Model.Instructor?.FullName??"Instructor")</strong></div></div></aside></div></div></div>

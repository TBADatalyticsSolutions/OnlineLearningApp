@model IEnumerable<OnlineLearningApp.Models.Course>

@{
    ViewData["Title"] = "Courses";
    var total = Model.Count();
}

<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <section class="catalog-hero mb-4 mb-lg-5">
        <div class="row align-items-center g-4 position-relative">
            <div class="col-xl-7">
                <span class="badge rounded-pill hero-pill px-3 py-2 mb-3"><i class="bi bi-stars me-1"></i> LEARN • BUILD • ADVANCE</span>
                <h1 class="display-4 fw-bold mb-3">Build skills that move your career forward.</h1>
                <p class="lead mb-4" style="color:#d6e7fb;max-width:680px;">Learn AI, data, cybersecurity, cloud and software development through practical, project-focused courses.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="#courses" class="btn btn-light btn-lg px-4"><i class="bi bi-grid me-2"></i> Explore courses</a>
                    @if (User?.Identity?.IsAuthenticated != true) { <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4">Create free account</a> }
                </div>
            </div>
            <div class="col-xl-5">
                <form asp-action="Filter" method="get" class="hero-search">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0 ps-3"><i class="bi bi-search text-secondary"></i></span>
                        <input type="text" name="searchString" class="form-control" placeholder="Search courses, topics or skills..." aria-label="Search courses" />
                        <button type="submit" class="btn btn-primary px-4">Search</button>
                    </div>
                </form>
                <div class="row g-2 mt-3 text-center">
                    <div class="col-4"><div class="small fw-bold">@total+</div><div class="small" style="color:#bdd3ed;">Courses</div></div>
                    <div class="col-4"><div class="small fw-bold">3</div><div class="small" style="color:#bdd3ed;">Modules/course</div></div>
                    <div class="col-4"><div class="small fw-bold">100%</div><div class="small" style="color:#bdd3ed;">Practical</div></div>
                </div>
            </div>
        </div>
    </section>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="category-chip active" href="@Url.Action("Index")">All Courses</a>
        <span class="category-chip">AI & Data</span>
        <span class="category-chip">Development</span>
        <span class="category-chip">Cybersecurity</span>
        <span class="category-chip">Cloud & DevOps</span>
        <span class="category-chip">Data Engineering</span>
        <span class="category-chip">Kids & STEM</span>
    </div>

    <div id="courses" class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <div class="eyebrow">Learning catalog</div>
            <h2 class="section-title h2 mb-1">Featured courses</h2>
            <p class="text-muted-custom mb-0">@total courses available for your next skill upgrade.</p>
        </div>
        <div class="d-none d-md-block"><span class="small text-muted-custom">Sort: <strong>Newest</strong> <i class="bi bi-chevron-down"></i></span></div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-search display-4 text-secondary"></i>
            <h2 class="h4 fw-bold mt-3">No courses found</h2>
            <p class="text-muted-custom">Try a broader search term.</p>
            <a asp-action="Index" class="btn btn-soft">View all courses</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 row-cols-xxl-4 g-4">
            @foreach (var course in Model)
            {
                var initials = course.CourseName.Length >= 2 ? course.CourseName[..2].ToUpperInvariant() : course.CourseName.ToUpperInvariant();
                var courseIcon = course.Category switch
                {
                    OnlineLearningApp.Data.CourseCategory.AI => "bi-stars",
                    OnlineLearningApp.Data.CourseCategory.DataScience => "bi-bar-chart-line-fill",
                    OnlineLearningApp.Data.CourseCategory.MachineLearning => "bi-cpu-fill",
                    OnlineLearningApp.Data.CourseCategory.CyberSecurity => "bi-shield-lock-fill",
                    OnlineLearningApp.Data.CourseCategory.CloudComputing => "bi-cloud-fill",
                    OnlineLearningApp.Data.CourseCategory.BigData => "bi-database-fill",
                    OnlineLearningApp.Data.CourseCategory.WebDevelopment => "bi-code-slash",
                    OnlineLearningApp.Data.CourseCategory.Programming => "bi-terminal-fill",
                    _ => "bi-mortarboard-fill"
                };
                <div class="col">
                    <article class="course-card h-100 position-relative">
                        <div class="course-image course-image-enhanced">
                            <img src="@course.ImageURL" alt="@course.CourseName" onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="course-fallback" style="display:none;">
                                <i class="bi @courseIcon display-3"></i>
                                <span>@initials</span>
                            </div>
                            <div class="course-icon-overlay"><i class="bi @courseIcon"></i></div>
                            <span class="position-absolute top-0 start-0 m-3 category-badge">@course.Category</span>
                        </div>
                        <div class="p-4 d-flex flex-column h-100">
                            <div class="d-flex align-items-center gap-2 small text-muted-custom mb-2"><i class="bi bi-clock"></i> @((course.EndDate - course.StartDate).Days / 7) weeks <span>•</span> <span>@course.Status</span></div>
                            <h3 class="h5 course-title"><a asp-action="Details" asp-route-id="@course.Id" class="stretched-link text-decoration-none text-reset">@course.CourseName</a></h3>
                            <p class="course-description small">@course.Description</p>
                            <div class="mt-auto d-flex justify-content-between align-items-center gap-2 pt-2">
                                <div><div class="course-price">₦@course.Price.ToString("N0")</div><small class="text-muted-custom">Course fee</small></div>
                                <span class="btn btn-primary btn-sm px-3">View details <i class="bi bi-arrow-right ms-1"></i></span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
<style>
.course-image-enhanced { position:relative; overflow:hidden; }
.course-image-enhanced img { transition:transform .35s ease; }
.course-card:hover .course-image-enhanced img { transform:scale(1.04); }
.course-fallback { height:100%; min-height:190px; align-items:center; justify-content:center; flex-direction:column; gap:.25rem; background:linear-gradient(135deg,#0b2e59,#1f6f8b); color:#fff; font-weight:700; }
.course-fallback span { font-size:.75rem; letter-spacing:.16em; opacity:.8; }
.course-icon-overlay { position:absolute; right:1rem; bottom:1rem; width:48px; height:48px; display:grid; place-items:center; border-radius:14px; background:rgba(255,255,255,.92); color:var(--brand-600); box-shadow:0 8px 24px rgba(0,0,0,.12); font-size:1.25rem; }
.course-card .stretched-link::after { position:absolute; inset:0; content:""; }
.course-card .btn { position:relative; z-index:2; }
</style>

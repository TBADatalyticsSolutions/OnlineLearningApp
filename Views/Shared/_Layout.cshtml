<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TBA Datalytics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
<header class="app-navbar">
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand d-flex align-items-center gap-2 me-4" asp-controller="Course" asp-action="Index">
                <span class="brand-mark"><i class="bi bi-mortarboard-fill fs-5"></i></span>
                <span><span class="brand-name d-block">TBA Datalytics</span><span class="brand-subtitle">Online Learning</span></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#appNavigation" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="appNavigation">
                <ul class="navbar-nav gap-lg-1 me-auto">
                    <li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Course" asp-action="Index"><i class="bi bi-grid me-1"></i> Courses</a></li>
                    <li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Resources" asp-action="Index"><i class="bi bi-book-half me-1"></i> Resources</a></li>

                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole(UserRoles.Student))
                    {
                        <li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Learning" asp-action="Index"><i class="bi bi-journal-bookmark me-1"></i> My Learning</a></li>
                        <li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Quiz" asp-action="History"><i class="bi bi-clipboard2-check me-1"></i> Assessments</a></li>
                    }

                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole(UserRoles.Instructor))
                    {
                        <li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Instructor" asp-action="Index"><i class="bi bi-person-workspace me-1"></i> Instructor</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link app-nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-mortarboard me-1"></i> Content</a>
                            <ul class="dropdown-menu shadow border-0 rounded-3 p-2">
                                <li><a class="dropdown-item rounded-2" asp-controller="Module" asp-action="Index">Modules</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Quiz" asp-action="Index">Quizzes</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Question" asp-action="Index">Questions</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Option" asp-action="Index">Options</a></li>
                            </ul>
                        </li>
                    }

                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole(UserRoles.Admin))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link app-nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-sliders me-1"></i> Management</a>
                            <ul class="dropdown-menu shadow border-0 rounded-3 p-2">
                                <li><a class="dropdown-item rounded-2" asp-controller="Course" asp-action="Index">Courses</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Course" asp-action="Create">Create course</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Account" asp-action="Users">Users</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Orders" asp-action="Index">Orders</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Module" asp-action="Index">Modules</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Quiz" asp-action="Index">Quizzes</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Question" asp-action="Index">Questions</a></li>
                                <li><a class="dropdown-item rounded-2" asp-controller="Option" asp-action="Index">Options</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <form class="d-flex my-3 my-lg-0 me-lg-3" asp-controller="Course" asp-action="Filter" method="get">
                    <div class="input-group app-search">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
                        <input name="searchString" class="form-control border-0 bg-transparent shadow-none" placeholder="Search courses, topics..." aria-label="Search courses" />
                    </div>
                </form>

                <ul class="navbar-nav align-items-lg-center">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(UserRoles.Student))
                        {
                            <li class="nav-item me-lg-2">@await Component.InvokeAsync("ShoppingCartSummary")</li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 app-nav-link" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="brand-mark" style="width:34px;height:34px;border-radius:10px;"><i class="bi bi-person-fill"></i></span>
                                <span class="d-none d-xl-inline">@User.Identity.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-2">
                                @if (User.IsInRole(UserRoles.Student))
                                {
                                    <li><a class="dropdown-item rounded-2" asp-controller="Learning" asp-action="Index"><i class="bi bi-journal-bookmark me-2"></i> My Learning</a></li>
                                    <li><a class="dropdown-item rounded-2" asp-controller="Quiz" asp-action="History"><i class="bi bi-clipboard2-check me-2"></i> Assessment history</a></li>
                                }
                                @if (User.IsInRole(UserRoles.Instructor))
                                {
                                    <li><a class="dropdown-item rounded-2" asp-controller="Instructor" asp-action="Index"><i class="bi bi-person-workspace me-2"></i> Instructor dashboard</a></li>
                                }
                                @if (User.IsInRole(UserRoles.Admin))
                                {
                                    <li><a class="dropdown-item rounded-2" asp-controller="Account" asp-action="Users"><i class="bi bi-people me-2"></i> User directory</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item rounded-2 text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i> Sign out</button></form></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link app-nav-link" asp-controller="Account" asp-action="SignIn">Sign in</a></li>
                        <li class="nav-item"><a class="btn btn-primary px-3 ms-lg-2" asp-controller="Account" asp-action="Register">Get started</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="page-shell">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="site-footer py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
                    <strong class="text-white fs-5">TBA Datalytics</strong>
                </div>
                <p class="small mb-0">Practical digital skills for the next generation of builders, analysts and technology professionals.</p>
            </div>
            <div class="col-6 col-lg-2"><strong class="text-white">Learn</strong><div class="small mt-2"><a asp-controller="Course" asp-action="Index">Courses</a><br/><a asp-controller="Resources" asp-action="Index">Resources</a><br/><a asp-controller="Verification" asp-action="Index">Verify certificate</a></div></div>
            <div class="col-6 col-lg-2"><strong class="text-white">Platform</strong><div class="small mt-2"><a asp-controller="Home" asp-action="Privacy">Privacy</a><br/><a asp-controller="Account" asp-action="Register">Register</a></div></div>
        </div>
        <hr class="border-secondary my-4" />
        <div class="small">© @DateTime.Now.Year TBA Datalytics. All rights reserved.</div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model OnlineLearningApp.Models.Certificate
@{ ViewData["Title"] = "Certificate"; Layout = null; }
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · @Model.Course.CourseName</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><style>body{background:#eef3f8;font-family:Inter,system-ui,sans-serif;color:#10233f}.certificate{max-width:1100px;margin:40px auto;background:#fff;border:12px solid #0b2550;padding:12px;box-shadow:0 20px 60px rgba(7,26,51,.15)}.inner{border:2px solid #2389ff;padding:70px 80px;text-align:center;min-height:680px;display:flex;flex-direction:column;justify-content:center}.brand{letter-spacing:.22em;text-transform:uppercase;color:#1976e8;font-weight:800}.title{font-family:Georgia,serif;font-size:56px;font-weight:700;color:#0b2550}.student{font-family:Georgia,serif;font-size:42px;border-bottom:2px solid #cbd5e1;display:inline-block;padding:0 28px 10px;margin:20px 0}.course{font-size:27px;font-weight:700;color:#1559a6}.meta{color:#64748b}.seal{width:90px;height:90px;border:3px solid #2389ff;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:35px auto 15px;color:#1976e8;font-weight:800}@media print{body{background:#fff}.certificate{margin:0;box-shadow:none;max-width:none}.inner{min-height:620px}.no-print{display:none!important}}</style></head><body><div class="no-print text-center py-3"><a class="btn btn-primary" href="@Url.Action("Pdf", new { courseId = Model.CourseId })">Download PDF</a><button class="btn btn-outline-primary" onclick="window.print()">Print / Save as PDF</button><a class="btn btn-outline-secondary" href="@Url.Action("Index","Learning")">Back to My Learning</a><a class="btn btn-outline-primary" href="@Url.Action("Index","Verification", new { certificateNumber = Model.CertificateNumber })">Verify certificate</a></div><section class="certificate"><div class="inner"><div class="brand">TBA Datalytics Learning</div><div class="title mt-4">Certificate of Completion</div><p class="meta mt-4 mb-0">This certificate is proudly presented to</p><div class="student">@Model.Student.FullName</div><p class="meta">for successfully completing the learning pathway</p><div class="course">@Model.Course.CourseName</div><div class="seal">TBA</div><p class="meta mb-1">Issued @Model.IssuedAt.ToString("dd MMMM yyyy")</p><p class="small text-muted">Certificate No. @Model.CertificateNumber</p></div></section></body></html>

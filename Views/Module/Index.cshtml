@model IEnumerable<OnlineLearningApp.Models.Module>
@{
    ViewData["Title"] = "Modules";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="mb-4">
        <div class="eyebrow">Academic content</div>
        <h1 class="section-title h2 mb-1">Course modules</h1>
        <p class="text-muted-custom mb-0">Review the learning modules currently available in the platform.</p>
    </div>
    <div class="row g-4">
        @foreach (var module in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="dashboard-card h-100 p-4">
                    <span class="category-badge">Module @module.ModuleId</span>
                    <h2 class="h5 fw-bold mt-3">@module.ModuleName</h2>
                    <p class="small text-muted-custom">@module.Content</p>
                    <div class="small text-muted-custom mb-3">
                        <i class="bi bi-journal-text me-1"></i> @module.Quizzes.Count checkpoint(s)
                    </div>
                    <a asp-controller="Course" asp-action="Details" asp-route-id="@module.CourseId" class="btn btn-soft btn-sm">
                        View course <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </article>
            </div>
        }
    </div>
</div>

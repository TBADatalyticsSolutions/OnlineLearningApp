@model IEnumerable<OnlineLearningApp.Models.Option>
@{
    ViewData["Title"] = "Options";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="mb-4">
        <div class="eyebrow">Academic content</div>
        <h1 class="section-title h2 mb-1">Answer options</h1>
        <p class="text-muted-custom mb-0">Review the options configured for assessment questions.</p>
    </div>
    <div class="surface p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="px-4 py-3">Option</th><th>Correct</th><th>Question</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4 fw-semibold">@item.OptionText</td>
                        <td>
                            @if (item.IsCorrect)
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success"><i class="bi bi-check-circle me-1"></i>Correct</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-light text-dark">Distractor</span>
                            }
                        </td>
                        <td>#@item.QuestionId</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

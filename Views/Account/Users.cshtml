@model IEnumerable<OnlineLearningApp.Models.Account>
@{
    ViewData["Title"] = "Users";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div><div class="eyebrow">Administration</div><h1 class="section-title h2 mb-1">User directory</h1><p class="text-muted-custom mb-0">Review platform accounts and their assigned application roles.</p></div>
        <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">@Model.Count() users</span>
    </div>
    <div class="surface p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="px-4 py-3">Name</th><th>Email</th><th>Username</th><th>Role</th><th class="px-4">Status</th></tr></thead>
                <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="px-4 fw-semibold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.UserName</td>
                        <td><span class="badge rounded-pill bg-light text-dark">@user.Role</span></td>
                        <td class="px-4">@if (user.EmailConfirmed) { <span class="text-success"><i class="bi bi-check-circle me-1"></i>Confirmed</span> } else { <span class="text-warning"><i class="bi bi-clock me-1"></i>Unconfirmed</span> }</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

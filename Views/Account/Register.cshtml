@model RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="surface p-4 p-lg-5">
                <div class="eyebrow">Start learning</div>
                <h1 class="h2 fw-bold mt-2">Create your learner account</h1>
                <p class="text-muted-custom">Registration creates a Student account. Administrative roles are assigned separately.</p>
                <form asp-action="Register" method="post" class="mt-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                    <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control form-control-lg" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                    <div class="mb-3"><label asp-for="EmailAddress" class="form-label"></label><input asp-for="EmailAddress" class="form-control form-control-lg" autocomplete="email" /><span asp-validation-for="EmailAddress" class="text-danger small"></span></div>
                    <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control form-control-lg" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                    <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
                    <button class="btn btn-primary btn-lg w-100" type="submit">Create account <i class="bi bi-arrow-right ms-1"></i></button>
                </form>
                <p class="small text-center text-muted-custom mt-4 mb-0">Already registered? <a asp-action="SignIn">Sign in</a>.</p>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

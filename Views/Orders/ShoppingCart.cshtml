@model OnlineLearningApp.ShoppingCartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    @if (TempData["Success"] is string success) { <div class="alert alert-success rounded-4">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger rounded-4">@error</div> }
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div><div class="eyebrow">Enrollment checkout</div><h1 class="section-title h2 mb-1">Shopping cart</h1><p class="text-muted-custom mb-0">Review your selected learning pathways before placing your order.</p></div>
        <a asp-controller="Course" asp-action="Index" class="btn btn-soft">Continue browsing</a>
    </div>
    @if (!Model.ShoppingCartItems.Any())
    {
        <div class="empty-state"><i class="bi bi-cart-x display-4 text-primary"></i><h2 class="h4 fw-bold mt-3">Your cart is empty</h2><p class="text-muted-custom">Add a course to get started.</p><a asp-controller="Course" asp-action="Index" class="btn btn-primary">Explore courses</a></div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-xl-8">
                <div class="d-grid gap-3">
                @foreach (var item in Model.ShoppingCartItems)
                {
                    <div class="dashboard-card p-3 p-lg-4">
                        <div class="d-flex gap-3 align-items-center">
                            <div class="ratio ratio-16x9 rounded-3 overflow-hidden bg-light" style="width:150px;flex-shrink:0;"><img src="@item.Course.ImageURL" class="w-100 h-100 object-fit-cover" alt="@item.Course.CourseName" /></div>
                            <div class="flex-grow-1"><span class="category-badge">@item.Course.Category</span><h2 class="h5 fw-bold mt-2 mb-1">@item.Course.CourseName</h2><div class="text-muted-custom small">@item.Amount × ₦@item.Course.Price.ToString("N2")</div></div>
                            <form asp-action="RemoveItemFromShoppingCart" method="post">
                                <input type="hidden" name="id" value="@item.Course.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-dash-circle me-1"></i> Remove</button>
                            </form>
                        </div>
                    </div>
                }
                </div>
            </div>
            <div class="col-xl-4">
                <div class="surface p-4 sticky-lg-top" style="top:92px;">
                    <div class="eyebrow">Order summary</div>
                    <div class="d-flex justify-content-between py-3 border-bottom"><span>Items</span><strong>@Model.ShoppingCartItems.Sum(i => i.Amount)</strong></div>
                    <div class="d-flex justify-content-between py-3"><span>Total</span><strong class="fs-4 text-primary">₦@Model.ShoppingCartTotal.ToString("N2")</strong></div>
                    <form asp-action="CompleteOrder" method="post"><button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-check2-circle me-1"></i> Place order</button></form>
                    <p class="small text-muted-custom mt-3 mb-0">Payment processing is not yet connected. This action records the order in the platform.</p>
                </div>
            </div>
        </div>
    }
</div>

@model IEnumerable<OnlineLearningApp.Order>
@{
    ViewData["Title"] = "My Orders";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div><div class="eyebrow">Account</div><h1 class="section-title h2 mb-1">Orders</h1><p class="text-muted-custom mb-0">Review your course purchases and order history.</p></div>
        <a asp-action="ShoppingCart" class="btn btn-primary"><i class="bi bi-cart3 me-1"></i> Cart</a>
    </div>
    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-receipt display-4 text-primary"></i><h2 class="h4 fw-bold mt-3">No orders yet</h2><p class="text-muted-custom">Your completed course orders will appear here.</p></div>
    }
    else
    {
        <div class="surface p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th class="px-4 py-3">Order</th><th>Date</th><th>Items</th><th class="text-end px-4">Total</th></tr></thead>
                    <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="px-4 fw-semibold">#@order.Id.ToString("D6")</td>
                            <td>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                            <td>@order.OrderItems.Sum(i => i.Quantity) course item(s)</td>
                            <td class="text-end px-4 fw-bold">₦@order.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@{
    ViewData["Title"] = "Order Completed";
}
<div class="container py-5">
    <div class="row justify-content-center"><div class="col-lg-7">
        <div class="surface p-5 text-center">
            <div class="stat-icon mx-auto mb-3"><i class="bi bi-check2-circle"></i></div>
            <h1 class="h2 fw-bold">Order recorded</h1>
            <p class="text-muted-custom">Your order has been saved successfully. An administrator can review it from the order dashboard.</p>
            <div class="d-flex justify-content-center gap-2 mt-4"><a asp-controller="Learning" asp-action="Index" class="btn btn-primary">My Learning</a><a asp-controller="Orders" asp-action="Index" class="btn btn-soft">View orders</a></div>
        </div>
    </div></div>
</div>

@model OnlineLearningApp.Models.QuizHistoryViewModel
@{
    ViewData["Title"] = "Assessment history";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div><div class="eyebrow">Assessments</div><h1 class="section-title h2 mb-1">Quiz history</h1><p class="text-muted-custom mb-0">Review your checkpoint attempts, scores and pass status.</p></div>
        <a asp-controller="Learning" asp-action="Index" class="btn btn-soft">My Learning</a>
    </div>
    @if (!Model.Attempts.Any())
    {
        <div class="empty-state"><i class="bi bi-ui-checks display-4 text-primary"></i><h2 class="h4 fw-bold mt-3">No assessments yet</h2><p class="text-muted-custom">Complete a course checkpoint and your result will appear here.</p></div>
    }
    else
    {
        <div class="surface p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th class="px-4 py-3">Assessment</th><th>Course</th><th>Score</th><th>Percentage</th><th>Status</th><th class="px-4">Attempted</th></tr></thead>
                    <tbody>
                    @foreach (var attempt in Model.Attempts)
                    {
                        <tr>
                            <td class="px-4 fw-semibold">@attempt.QuizName</td>
                            <td>@attempt.CourseName</td>
                            <td>@attempt.Score / @attempt.TotalQuestions</td>
                            <td>@attempt.Percentage.ToString("0.00")%</td>
                            <td>
                                @if (attempt.Passed) { <span class="badge rounded-pill bg-success-subtle text-success">Passed</span> }
                                else { <span class="badge rounded-pill bg-warning-subtle text-warning">Not passed</span> }
                            </td>
                            <td class="px-4">@attempt.AttemptedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

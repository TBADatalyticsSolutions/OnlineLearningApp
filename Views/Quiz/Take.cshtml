@model OnlineLearningApp.Models.QuizAttemptViewModel

@{
    ViewData["Title"] = Model.QuizName;
}

<div class="container py-4">
    <a asp-controller="Course" asp-action="Learn" asp-route-id="@Model.CourseId" class="text-decoration-none">
        <i class="bi bi-arrow-left"></i> Back to learning
    </a>

    <div class="mt-3 mb-4">
        <span class="badge bg-primary mb-2">Checkpoint quiz</span>
        <h1 class="fw-bold">@Model.QuizName</h1>
        <p class="text-secondary">@Model.Description</p>
    </div>

    @if (Model.Submitted)
    {
        <div class="alert alert-success rounded-4">
            <h2 class="h5 fw-bold">Quiz submitted</h2>
            <p class="mb-0">You scored <strong>@Model.Score / @Model.TotalQuestions</strong>.</p>
        </div>
    }

    <form asp-action="Submit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="QuizId" value="@Model.QuizId" />

        @for (var i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="small text-primary fw-semibold mb-2">Question @(i + 1)</div>
                    <h2 class="h5 fw-semibold">@question.QuestionText</h2>

                    <div class="mt-3">
                        @foreach (var option in question.Options)
                        {
                            <div class="form-check p-3 border rounded-3 mb-2">
                                <input class="form-check-input ms-0 me-2" type="radio"
                                       name="Answers[@question.QuestionId]"
                                       value="@option.OptionId"
                                       id="option-@option.OptionId"
                                       @(Model.Answers.TryGetValue(question.QuestionId, out var selected) && selected == option.OptionId ? "checked" : "") />
                                <label class="form-check-label" for="option-@option.OptionId">
                                    @option.OptionText
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary btn-lg" @(Model.Submitted ? "disabled" : "")>
                <i class="bi bi-check2-circle"></i> Submit quiz
            </button>
            <a asp-controller="Course" asp-action="Learn" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary btn-lg">
                Back to course
            </a>
        </div>
    </form>
</div>

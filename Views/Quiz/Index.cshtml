@model IEnumerable<OnlineLearningApp.Models.Quiz>
@{
    ViewData["Title"] = "Quizzes";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="mb-4">
        <div class="eyebrow">Academic content</div>
        <h1 class="section-title h2 mb-1">Checkpoint assessments</h1>
        <p class="text-muted-custom mb-0">Review the quizzes attached to course modules.</p>
    </div>
    <div class="surface p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="px-4 py-3">Assessment</th><th>Description</th><th>Module</th><th>Questions</th><th>Pass mark</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4 fw-semibold">@item.QuizName</td>
                        <td class="small text-muted-custom">@item.Description</td>
                        <td>#@item.ModuleId</td>
                        <td>@item.Questions.Count</td>
                        <td>@item.PassMark.ToString("0.##")%</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<OnlineLearningApp.Models.Question>
@{
    ViewData["Title"] = "Questions";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="mb-4">
        <div class="eyebrow">Academic content</div>
        <h1 class="section-title h2 mb-1">Question bank</h1>
        <p class="text-muted-custom mb-0">Review assessment questions used by course checkpoints.</p>
    </div>
    <div class="surface p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th class="px-4 py-3">Question</th><th>Type</th><th>Quiz</th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4 fw-semibold">@item.QuestionText</td>
                        <td><span class="badge rounded-pill bg-light text-dark">@item.QuestionType</span></td>
                        <td>#@item.QuizId</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

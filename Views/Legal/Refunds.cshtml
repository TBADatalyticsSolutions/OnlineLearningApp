@{ ViewData["Title"] = "Payment & Refund Policy"; }
<div class="container py-5">
    <div class="surface p-4 p-lg-5">
        <div class="eyebrow">TBA Datalytics Online Learning</div>
        <h1 class="h2 fw-bold mt-2">Payment & Refund Policy</h1>
        <p class="text-muted-custom">Last updated: October 3, 2026</p>
        <h2 class="h5 mt-4">Payment confirmation</h2>
        <p>A course order remains pending until the configured payment process confirms settlement. Learners cannot use a pending order as proof of payment.</p>
        <h2 class="h5 mt-4">Access after payment</h2>
        <p>Once payment is confirmed, the learner's paid entitlement can unlock graded assessments. Course completion and certificate issuance remain subject to the course's other published requirements.</p>
        <h2 class="h5 mt-4">Refund requests</h2>
        <p>Refund eligibility depends on the course, transaction, applicable payment-provider rules, and the circumstances of the request. Contact support with the order number and payment reference for review.</p>
        <h2 class="h5 mt-4">Fraud and chargebacks</h2>
        <p>Suspected fraudulent transactions or reversed payments may cause course assessment and certificate access to be suspended while the transaction is reviewed.</p>
    </div>
</div>

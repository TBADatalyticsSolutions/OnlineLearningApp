@{
    ViewData["Title"] = "Learning Resources";
}
<div class="container-fluid px-3 px-lg-4 py-4 py-lg-5">
    <div class="catalog-hero mb-5">
        <div class="eyebrow" style="color:#7fc0ff;">Resource library</div>
        <h1 class="display-6 fw-bold mt-2">Learn beyond the classroom.</h1>
        <p class="lead mb-0" style="color:#cfe1f7;">Curated documentation, guided study notes, and practical references from trusted sources.</p>
    </div>
    <div class="row g-4">
        <div class="col-lg-6 col-xl-3"><div class="dashboard-card p-4 h-100"><span class="category-badge">Python</span><h2 class="h5 fw-bold mt-3">Python foundations</h2><p class="small text-muted-custom">Syntax, data structures, functions, modules, files, exceptions, and the standard library.</p><div class="d-grid gap-2 mt-4"><a class="btn btn-primary" href="/resources/python-data-science-starter.html">Open study guide</a><a class="btn btn-soft" target="_blank" rel="noopener" href="https://docs.python.org/3/tutorial/">Official Python Tutorial</a></div></div></div>
        <div class="col-lg-6 col-xl-3"><div class="dashboard-card p-4 h-100"><span class="category-badge">Data Science</span><h2 class="h5 fw-bold mt-3">Pandas & data analysis</h2><p class="small text-muted-custom">A practical path for loading, cleaning, transforming, summarizing, and visualizing tabular data.</p><div class="d-grid gap-2 mt-4"><a class="btn btn-primary" href="/resources/pandas-data-analysis-starter.html">Open study guide</a><a class="btn btn-soft" target="_blank" rel="noopener" href="https://pandas.pydata.org/docs/getting_started/intro_tutorials/">Pandas tutorials</a></div></div></div>
        <div class="col-lg-6 col-xl-3"><div class="dashboard-card p-4 h-100"><span class="category-badge">BI</span><h2 class="h5 fw-bold mt-3">Power BI</h2><p class="small text-muted-custom">Follow a structured route from data import and Power Query through modeling and interactive reporting.</p><div class="d-grid gap-2 mt-4"><a class="btn btn-primary" href="/resources/power-bi-starter.html">Open study guide</a><a class="btn btn-soft" target="_blank" rel="noopener" href="https://learn.microsoft.com/en-us/training/paths/prepare-data-power-bi/">Microsoft Learn path</a></div></div></div>
        <div class="col-lg-6 col-xl-3"><div class="dashboard-card p-4 h-100"><span class="category-badge">Git & AI</span><h2 class="h5 fw-bold mt-3">Professional development</h2><p class="small text-muted-custom">A compact workflow for Git, GitHub collaboration, AI-assisted coding, testing, and responsible review.</p><div class="d-grid gap-2 mt-4"><a class="btn btn-primary" href="/resources/git-ai-development-starter.html">Open study guide</a><a class="btn btn-soft" target="_blank" rel="noopener" href="https://skills.github.com/">GitHub Skills</a></div></div></div>
    </div>
</div>
